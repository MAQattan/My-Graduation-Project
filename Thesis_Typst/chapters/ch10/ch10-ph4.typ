          عاكس ذكي ثلاثي الأطوار (*3-Phase AC*) باستطاعة اسمية فعالة تبلغ *25kW* وجهد خرج مقنن *400V* وتردد *50Hz*. طراز: *Huawei SUN2000-25KTL-M5*. مزود بتقنية متتبعات متعددة لنقطة الاستطاعة القصوى (*Multi-MPPT*)، نظام حماية متكامل مدمج ضد القوس الكهربائي (AFCI)، وكفاءة أوروبية لا تقل عن 98%.
        ], [Huawei Technologies], [عدد], [*1*],

        [3], [
          *مصاهر حماية السلاسل في جانب التيار المستمر (DC Fuses):* \ \
          مصاهر أسطوانية متخصصة لحماية الأنظمة الكهروضوئية من الفئة الفنية *gPV* لحماية السلاسل في الأقطاب الموجبة والسالبة ضد التيارات العكسية. السعة الاسمية ($I_n$): *25A*، والجهد المقنن: *1000V DC*، وسعة قطع لحظية لا تقل عن *30kA*. تورد كاملة مع حوامل المصاهر المعزولة الخاصة بها للقضبان الداعمة (DIN Rail).
        ], [Schneider / ABB / Bussmann], [عدد], [*6*],

        [4], [
          *قواطع عزل جانب التيار المستمر (DC MCB):* \ \
          قواطع مغناطيسية حرارية مصممة للتيار المستمر ثنائية الأقطاب (*$2-"Pole"$*)، تستخدم لتأمين حماية إضافية ونقطة عزل ميكانيكية مستقلة لكل سلسلة قبل الدخول للعاكس. السعة الاسمية: *32A*، والجهد التشغيلي المقنن: *1000V DC*.
        ], [Schneider / ABB], [عدد], [*3*],

        [5], [
          *مانعات الصواعق والجهود العابرة لجانب المستمر (DC SPD):* \ \
          جهاز حماية من الارتفاع المفاجئ في الجهد والجهود العابرة الناتجة عن الصواعق من النوع (*Type II*) مخصص للتيار المستمر. جهد العمل الآمن المقنن: *1000V DC*، ومزود بمؤشر بصري يوضح كفاءة عمل كبسولات الحماية القابلة للاستبدال.
        ], [Schneider / Phoenix Contact], [عدد], [*3*],

        [6], [
          *لوحة تجميع وحماية جانب التيار المستمر (DC Combiner Box):* \ \
          لوحة تجميع خارجية فارغة مصنوعة من مادة البولي كربونيت المقاومة للصدمات وللأشعة فوق البنفسجية (*UV-Stabilized Polycarbonate, Class II*). ذات درجة حماية عالمية لا تقل عن *IP66* لتتحمل التموضع الخارجي على السطح، مجهزة بـ DIN Rail ومرابط كابلات وغدد غلق محكمة الإغلاق لكابلات الدخل والخرج.
        ], [Schneider / Hensel], [عدد], [*1*],

        [7], [
          *كابلات طاقة شمسية متخصصة لجانب المستمر (DC Solar Cables):* \ \
          كابلات طاقة شمسية مطابقة للمواصفة الأوروبية *EN 50618*. الموصل من النحاس المرن متعدد النوى المكسو بالقصدير (*Tinned Copper*) لمقاومة الأكسدة والرطوبة. عزل مزدوج من مادة البولي أوليفين المتشابك الخالي من الهالوجين ومنخفض انبعاث الدخان (*XLPO/LSZH*)، مقاوم للأشعة فوق البنفسجية. المقطع المقنن: *4 mm²* باللونين الأحمر والأسود لتمييز الأقطاب.
        ], [KBE / Prysmian / السويدي], [متر طولي], [*300* \ _(تقديري)_],

        [8], [
          *موصلات السلاسل الشجرية (MC4 Connectors):* \
          أزواج من وصلات الذكر والأنثى من طراز *MC4* القياسي، ذات درجة حماية *IP68*، ومقاومة للأشعة فوق البنفسجية ومصممة لتحمل تيارات حتى 40A وجهود تصل لـ 1000V DC، تستخدم لربط نهايات السلاسل باللوحة.
        ], [Stäubli (MC4 Original)], [زوج], [*12* \ _(تقديري)_],

        [9], [
          *قاطع جانب التيار المتردد الرئيسي (Main AC Circuit Breaker):* \
          قاطع تيار حراري مغناطيسي رباعي الأقطاب (*4-Pole: 3P+N*)، يستخدم كحماية وعزل رئيسي لخرج العاكس المتردد. السعة الاسمية المقننة: *50A*. سعة قطع الأعطال ($I_(c u)$) لا تقل عن *25kA* عند جهد 400V AC لضمان إخماد القوس الكهربائي بأمان والربط مع باسبارات الشبكة.
        ], [Schneider / ABB], [عدد], [*1*],

        [10], [
          *مانع الصواعق والجهود العابرة لجانب المتردد (AC SPD):* \
          جهاز حماية من الارتفاع المفاجئ في الجهد من النوع (*Type II*) رباعي الأقطاب (*4-Pole*) مخصص لأنظمة التيار المتردد ثلاثية الأطوار، متوافق مع جهد الشبكة في الموقع (400V AC) لحماية العاكس من النبضات القادمة من جهة الشبكة.
        ], [Schneider / Phoenix Contact], [عدد], [*1*],

        [11], [
          *لوحة توزيع وحماية جانب التيار المتردد (ACDB Enclosure):* \
          لوحة جدارية معدنية أو بلاستيكية صلبة ذات درجة حماية لا تقل عن *IP65* للاستخدام الداخلي/المحمي، مجهزة بمؤشرات إضاءة نيون للأطوار الثلاثة (*3-Phase Neon Indicators*)، وجهاز قياس رقمي متعدد الوظائف (Digital Multifunction Meter) لقراءة الجهد والتيار والتردد.
        ], [Schneider / ABB], [عدد], [*1*],

        [12], [
          *كابل الطاقة المتردد الرئيسي (Main AC Cable):* \
          كابل طاقة نحاسي متعدد النوى مجدول راتب (*Cu*) معزول بمادة البولي إيثيلين المشابك (*XLPE*) ومغلف بطبقة خارجية من الـ *PVC* مطابق للمواصفة الدولية *IEC 60502-1*. المقطع الهندسي المقنن المعتمد: $4 times 10 "mm"^2$ لنقل تيار الخرج البالغ تشغيلياً 38A وضمان هبوط جهد مثالي يبلغ $0.717\%$ (أقل من حد 1%).
        ], [شركة السويدي للكابلات], [متر طولي], [*50* \ _(تقديري)_],

        [13], [
          *هياكل التثبيت الميكانيكية (Mounting Structures):* \
          هياكل تثبيت هندسية مصممة خصيصاً للتوزيع والنمط المتدرج (*Terraced / Stepped Structures*) للاستغلال الأعظمي للمساحة المتاحة ($129 "m"^2$). مجاري التثبيت (Rails) مصنوعة من الألمنيوم المؤكسد عالي الصلابة (*Anodized Aluminum*)، والقواعد والأرجل الداعمة من الحديد المجلفن على الساخن (*Hot-Dip Galvanized Steel*). مصممة لزاوية ميل ثابتة $31degree$ وتوجيه جنوبي كامل ($0degree$ Azimuth) ومقاومة للرياح العالية. تشمل كافة مثبتات الألواح البينية والطرفية والبراغي المصنوعة بالكامل من الفولاذ المقاوم للصدأ (*Stainless Steel A2/A4-70*).
        ], [مواصفات هندسية قياسية], [مجموعة متكاملة], [*1*],

        [14], [
          *منظومة التأريض والربط متساوي الجهد (Earthing System):* \
          شبكة تأريض متكاملة تشتمل على نواقل نحاسية عارية لتأريض شاسيهات الألواح، كابلات نحاسية معزولة باللون الأخضر/الأصفر مقطع $16 "mm"^2$ لتأريض العاكس واللوحات الكهربائية. تتضمن قضيب تأريض نحاسي نقي (*Solid Copper Earth Rod*) بطول *2m*، وغرفة تفتيش واختبار حقلية ومواد كيميائية لتحسين التربة لضمان تحقيق مقاومة كلية مستهدفة $<= 4 Omega$ امتثالاً للحسابات الرياضية.
        ], [مواصفات قياسية عالمية], [مجموعة متكاملة], [*1*],

        [15], [
          *منظومة مجاري وحماية الكابلات (Cable Management System):* \ 
          مجاري كابلات معدنية مخرمة ومجلفنة على الساخن (*Perforated Hot-Dip Galvanized Cable Trays*) مع أغطيتها لحماية الكابلات الممددة على السطح من أشعة الشمس المباشرة، بالإضافة إلى أنابيب صلبة ومرنة مقاومة للأشعة فوق البنفسجية وأحزمة ربط معدنية متينة لربط كابلات السلاسل بالهياكل.
        ], [مواصفات قياسية], [مجموعة متكاملة], [*1*]
      )
    ]
  )
)
  

