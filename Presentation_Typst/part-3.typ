#slide[
  = بناء التوأم الرقمي (Digital Twin) والمورد الجيومناخي
  #v(0.1cm)

  #grid(
    columns: (1fr, 1fr), // توزيع مثالي يخصص المساحة الأكبر للشروحات الهندسية ويحاذي الصورة يساراً بشكل أنيق
    gutter: 16pt,
    
    // العمود الأول (يمين): الفلسفة التصميمية والمعايير الجيومناخية الدقيقة للموقع المصرفي
    stack(
      dir: ttb,
      spacing: 10pt,
      
      titled-block(title: "فلسفة النمذجة الرقمية والمعايير الجيومناخية للموقع")[
        #set text(size: 13pt)
        #set par(leading: 0.9em)
        
        - *التوأم الرقمي (_Digital Twin_):* بناء نموذج حاسوبي ديناميكي متكامل في بيئة _PVsyst_ لمحاكاة السلوك الفيزيائي الفعلي للمنظومة تحت وطأة الظروف المناخية المتغيرة والمحدودية المكانية لسطح البنك.
        
        - *الهدف التصميمي الحرج:* الانتقال من التقديرات الساكنة التقليدية إلى التنبؤات الديناميكية الدقيقة للإنتاجية السنوية الإجمالية ($E_("sys")$) وتحليل تفصيلي لشجرة المفاقيد التشغيلية.
        
        - *الإحداثيات الجغرافية للموقع:* تحديد موقع المنشأة المصرفية بدقة عالية ($36.20degree$ شمالاً، $37.14degree$ شرقاً) بارتفاع يبلغ $379 "m"$ فوق سطح البحر.
        
        - *محرك الأرصاد الجوية المعتمد:* استيراد البيانات القياسية من قاعدة _Meteonorm 8.0_ لتوليد جداول الإشعاع الكلي والانتشاري (_Global & Diffuse Irradiance_) ومخططات درجات الحرارة الساعية المتوقعة للموقع.
        
        - *الاستمثال الهندسي للمصفوفة (_Quick Optimization_):* تأكيد مطابقة زاوية الميل ($31degree$) وزاوية السمت ($0degree$) مع القيم المثالية النظرية، مما يضمن تحقيق مفقودات توجيه انعدامية تماماً ($0.0\%$ loss).
      ]
    ),
    
    // العمود الثاني (يسار): إدراج واجهة برنامج PVsyst مع تصحيح صياغة رموز الزوايا في الكابشن
    align(center + horizon)[
      #figure(
        image("Figures/PV-11-02.png", width: 100%),
        caption: [واجهة ضبط وتأكيد معطيات توجيه وزاوية ميل المصفوفة الكهروضوئية ($beta = 31degree$) في برنامج $"PVsyst"$.]
      )
    ]
  )
]


#slide[
  = مؤشرات الجدارة الطاقية (Energy Merit Indicators)
  #v(0.02cm)

  // إدراج شريط نتائج المحاكاة الصادر عن بيئة PVsyst كمعيار بصري علوي فور العنوان
  #figure(
    rect(stroke: 0.5pt + luma(150), inset: 0pt)[
      #image("Figures/PV-11-06.png", width: 100%)
    ],
    caption: [ملخص نتائج المحاكاة يبرز قيمة الإنتاجية النوعية للمنظومة كمعيار للأداء الطاقي السنوي ومطابقتها لمعدل ساعات الذروة ومعامل الأداء.]
  )
  #v(0.05cm)

  #grid(
    columns: (1fr, 1fr), // تقسيم متناظر ومثالي لعرض المؤشرات ومقارنتها رياضياً
    gutter: 14pt,
    
    // العمود الأول (يمين): حصاد الطاقة الكلي والإنتاجية النوعية (Specific Yield)
    stack(
      dir: ttb,
      spacing: 8pt,
      
      titled-block(title: "حصاد الطاقة السنوي والإنتاجية النوعية (Specific Yield)")[
        #set text(size: 13pt)
        #set par(leading: 0.9em)
        
        - *حصاد الطاقة السنوي ($E_("Grid")$):* تؤكد نتائج النمذجة الديناميكية قدرة المنظومة الكهرضوئية على ضخ إجمالي طاقة صافية ومستقرة للشبكة العامة تقدر بـ $44.02"MWh""/""year"$.
        
        - *الإنتاجية النوعية (_Specific Yield - SY_):* تُعبر عن "الساعات التشغيلية الفعالة" للمنظومة سنوياً تحت الإشعاع الحقيقي، وتُحسب وفق الآتي:
          $ text("SY") = E_("Grid") / P_("array-STC") = (44020 " kWh") / (23.4 " kWp") = bold(1881 " kWh/kWp/year") $
          
        - *الدلالة الهندسية والجدوى:* كل $1"kWp"$ مركب من الألواح سينتج قرابة $1.9"MWh"$ سنوياً، وهي كفاءة إنتاجية مرتفعة تساهم بشكل مباشر في تقليص "فترة استرداد رأس المال" (_Payback Period_).
      ]
    ),
    
    // العمود الثاني (يسار): معامل الأداء الاستثنائي والتحقق الرياضي من اتساق النمذجة
    stack(
      dir: ttb,
      spacing: 8pt,
      
      titled-block(title: "معامل الأداء والتحقق من الاتساق الرياضي للمنظومة")[
        #set text(size: 13pt)
        #set par(leading: 0.7em)
        
        - *معامل الأداء (_Performance Ratio - PR_):* يُمثل المعيار العالمي الحاسم لجودة التصميم الهندسي للموقع المصرفي وتقليص المفاقيد الكلية:
          $ text("PR") = text("SY") / "PSH"_("tilted") = 1881 / 2106.4 = bold(89.3\%) $
          
        - *التقييم الفني الدقيق:* تُعد هذه القيمة ($89.3\%$) "رقماً قياسياً" (_Benchmark_) يتجاوز النطاق التقليدي للمنظومات ($75\% - 85\%$)، مما يوثق علمياً نجاح هندسة التثبيت وعزل الظلال الديناميكية.
        
        - *التحقق من الاتساق الرياضي للمحاكاة:*
          تطابق المخرجات الرقمية يثبت بدقة متناهية صحة العلاقة البنيوية الحاكمة:
          $ text("Specific Yield") = "PSH"_("tilted") times text("PR") $
          مما يمنح نتائج الدراسة موثوقية أكاديمية وهندسية كاملة غير قابلة للطعن.
      ]
    )
  )
]


#slide[
  = تحليل الإنتاجية المعايرة والمفاقيد اليومية
  #v(0.1cm)

  #grid(
    columns: (1.15fr, 1.1fr), // تقسيم مدروس لمنح كتلة المصطلحات الفنية مساحتها الكافية ومحاذاة المخطط يساراً
    gutter: 14pt,
    
    // العمود الأول (يمين): فلسفة المعايرة وتفكيك مكونات ميزان الطاقة اليومي السنوي
    stack(
      dir: ttb,
      spacing: 10pt,
      
      titled-block(title: "فلسفة المعايرة ومكونات الأداء التشغيلي السنوي")[
        #set text(size: 13pt)
        #set par(leading: 0.8em)
        
        - *فلسفة المعايرة (_Normalization_):* نَسب مخرجات المنظومة الكلية والضياعات إلى "الكيلوواط الذروي الواحد" ($1"k" "Wp"$) لتبسيط رصد الكفاءة التشغيلية اليومية وتسهيل المقارنة المعيارية العالمية.
        
        - *تفكيك مكونات الأداء اليومي (المعدلات السنوية للمنظومة):*
          - *الإنتاجية المفيدة ($Y_f$):* سجلت المنظومة متوسطاً متميزاً قدره $5.15"kWh/kWp/day"$ محقوناً بالكامل في الشبكة الكهربائية للمبنى المصرفي.
          - *الدلالة الهندسية:* كل $1"k" "Wp"$ مركب من الألواح ساهم بإنتاج ما يزيد عن خمس ساعات تشغيل كاملة من الطاقة الصافية يومياً.
          - *مفاقيد المصفوفة ($L_c$):* ضياعات جانب التيار المستمر الكلية الناتجة عن التأثير الحراري والاتساخ ومقاومة التمديدات، وبلغت $0.52"kWh/kWp/day"$.
          - *مفاقيد النظام ($L_s$):* ضياعات التحويل الطاقي الديناميكي داخل العاكس ($text("DC to AC")$) وحافظت على قيمتها الدنيا البالغة $0.09"kWh/kWp/day"$.
          
        - *الاستنتاج الفني الاستشاري:*
          تؤكد النتائج الموثقة أن "الطاقة المفيدة الصافية" هي المكون المهيمن والمسيطر بالكامل في ميزان الطاقة اليومي، مما يثبت هندسياً نجاح التصميم في تحييد المفاقيد واسترداد أقصى قدر ممكن من الفوتونات الساقطة.
      ]
    ),
    
    // العمود الثاني (يسار): إدراج المخطط البياني الشهري للمحاكاة المعايرة من برنامج PVsyst
    align(center + horizon)[
      #figure(
        image("Figures/PV-11-07.png", width: 100%),
        caption: [مخطط الإنتاجية المعايرة اليومية يوضح توزيع الطاقة المفيدة $Y_f$ مقابل مفاقيد المصفوفة $L_c$ ومفاقيد النظام $L_s$ لكل كيلوواط ذروة مركب.]
      )
    ]
  )
]

#slide[
  = مخطط تدفق المفاقيد السنوي (Annual Loss Diagram)
  #v(0.1cm)

  #grid(
    columns: (1.25fr, 1fr), // تقسيم هندسي ممتاز يمنح التحليل التفصيلي المساحة الكافية ويحاذي مخطط المفاقيد يساراً
    gutter: 14pt,
    
    // العمود الأول (يمين): التحليل الهرمي لتحولات الطاقة وتفكيك المفاقيد التشغيلية
    stack(
      dir: ttb,
      spacing: 10pt,
      
      titled-block(title: "التحليل الهرمي وتفكيك المفاقيد السنوية للمنظومة")[
        #set text(size: 12pt)
        #set par(leading: 0.8em)
        
        - *التحليل الهرمي لتحولات الطاقة:*
          - *المورد الخام:* تبدأ السلسلة بإشعاع أفقي كلي يبلغ $1862"kWh/m"^2$، يرتفع بفعل زاوية التوجيه المثالية ($31degree$) لتعظيم التقاط المورد الشمسي على مستوى الألواح.
          - *المحرك الفيزيائي:* تنتج المصفوفة طاقة اسمية عند الشروط المعيارية ($text("STC")$) قدرها $48.63"MWh"}$، تخضع بعدها مباشرة لسلسلة المفاقيد الديناميكية.
          
        - *تفكيك المفاقيد التشغيلية الفعليّة (_Loss Breakdown_):*
          - *المفاقيد الحرارية ($-4.64%$):* الفقد المهيمن تقنياً الناتج عن ارتفاع حرارة الخلايا، وهي نسبة ممتازة تعكس جدارة اختيار ألواح _LONGi_ ذات المعامل الحراري المنخفض.
          - *مفاقيد عدم التطابق ($-2.10%$):* تم تحجيمها ببراعة بفضل استراتيجية التوزيع الفعال للمتعقبات (_Multi-MPPT_) التي عزلت السلاسل المظللة بالكامل.
          - *المفاقيد الأومية في الكابلات ($-0.73%$):* البرهان الرقمي الحاسم على صحة ودقة التحجيم اليدوي للنواقل، حيث بقيت الضياعات بأمان تحت عتبة الـ $1%$ الأكاديمية الصارمة.
          - *مفاقيد تحويل العاكس ($-1.72%$):* تُثبت كفاءة التحويل العالية جداً لجسور الـ _IGBT_ الإلكترونية في عاكس هواوي المعتمد.
          
        - *الحصاد الطاقي النهائي:*
          استقرار الميزان الطاقي الإجمالي للمشروع عند طاقة صافية محقونة في الشبكة قدرها $44.02"MWh/year"}$، مع الحفاظ على معامل الأداء القياسي المنظومي الحاسم ($89.3%$).
      ]
    ),
    
    // العمود الثاني (يسار): إدراج مخطط تدفق المفاقيد السنوي الصادر عن بيئة PVsyst
    align(center + horizon)[
      #figure(
        rect(stroke: 0.5pt + luma(180), inset: 2pt, radius: 2pt)[
          #image("Figures/PV-11-08.png", width: 100%)
        ],
        caption: [مخطط تدفق المفاقيد السنوي يوضح الميزان الطاقي من الإشعاع الشمسي الخام وصولاً إلى الطاقة الصافية المحقونة في الشبكة وقدرها $44.02"MWh"}$.]
      )
    ]
  )
]



#slide[
  = الاستنتاجات الفنية والجدارة التصميمية
  #v(0.1cm)

  #grid(
    columns: (1fr, 1fr), // تقسيم متناظر يمنح الشريحة توازناً بصرياً ممتازاً لعرض الخلاصة
    gutter: 16pt,
    
    // العمود الأول (يمين): الجدارة المكانية والكهربائية للمنظومة المصرفية
    stack(
      dir: ttb,
      spacing: 12pt,
      
      titled-block(title: "1. كفاءة الاستغلال المكاني والميكانيكي")[
        #set text(size: 15pt)
        #set par(leading: 0.8em)
        
        - *تقنية التثبيت المتدرج (_Terraced Mounting_):* أثبتت نجاعتها المطلقة والعملية في تجاوز قيود السطح المعمارية الحادة للمبنى المصرفي.
        
        - *تعظيم كثافة الاستطاعة:* حققت المنظومة كثافة قياسية بلغت $119.59"W/m"^2$ مع تحييد كامل للمفاقيد البصرية والفيزيائية الناتجة عن التظليل المتبادل بين المصفوفات.
      ],
      
      titled-block(title: "2. الجدارة الكهربائية والتحكم الرقمي")[
        #set text(size: 15pt)
        #set par(leading: 0.8em)
        
        - *استراتيجية التوزيع الفعال (_Multi-MPPT_):* نجحت تماماً في عزل "العقوبة الطاقية" للظلال الموضعية الناشئة عن جدران المبنى لحماية السلاسل.
        
        - *كبح مفاقيد عدم التطابق (_Mismatch Losses_):* تم حصرها عند عتبة دنيا بلغت $2.10\%$ فقط، مما منع انهيار أداء المصفوفة الإجمالي وضمن استمرارية التدفق الطاقي.
      ]
    ),
    
    // العمود الثاني (يسار): مؤشرات الأداء العالمية والموثوقية الحرارية في بيئة حلب
    stack(
      dir: ttb,
      spacing: 12pt,
      
      titled-block(title: "3. مؤشرات الأداء القياسية والجدوى")[
        #set text(size: 15pt)
        #set par(leading: 0.8em)
        
        - *التحقق عبر التوأم الرقمي:* أكد بناء النموذج الحاسوبي جدارة التصميم بتحقيق معامل أداء استثنائي وعالمي ($text("PR") = 89.3%$).
        
        - *الإنتاجية النوعية المرتفعة:* بلغت $1881"kWh/kWp/year"$، وهي أرقام تتجاوز المعدلات النمطية للمشاريع المماثلة، مما يساهم مباشرة في تقليص "فترة استرداد رأس المال" (_Payback Period_).
      ],
      
      titled-block(title: "4. الموثوقية المناخية والتحمل الحراري")[
        #set text(size: 15pt)
        #set par(leading: 0.8em)
        
        - *صمود المكونات الحرجية:* أثبت التحليل الحراري المتقدم استقرار جهود المصفوفة وصمود المعدات المعتمدة (ألواح _LONGi_ وعاكس _Huawei_) أمام الظروف المناخية المتطرفة لمدينة حلب.
        
        - *المفاقيد الحرارية المنظومية:* حافظت على مستويات منخفضة وآمنة هندسياً بلغت $4.64%$ بالرغم من قساوة ذروة البيئة التشغيلية الصيفية.
      ]
    )
  )
