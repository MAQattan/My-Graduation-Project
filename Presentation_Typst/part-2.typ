#slide[
  = توزيع الألواح الشمسية
  #v(0.1cm)

  #grid(
    columns: (1fr, 1.3fr), // توزيع مساحي مدروس لراحة القراءة ومواكبة كثافة النص
    gutter: 18pt,
    
    // العمود الأول (يمين): الفلسفة الهندسية والمبررات التقنية للابتكار المكاني
    stack(
      dir: ttb,
      spacing: 10pt, // مسافة أمان عمودية تفصل بين الصناديق التقنية
      
      titled-block(title: "تحييد العقبة المساحية")[
        #set text(size: 13pt)
        #set par(leading: 0.55em)
        
        *نهج التثبيت المتدرج:* الانتقال من نمط التثبيت التقليدي بمسافات بينية واسعة (التي تهدر *40-50%* من المساحة) إلى نمط *"درجات السلم" (Staircase)* لتقليص المسافة البينية ($D$) إلى *الصفر*.
        #v(0em)
        *النتيجة :*
        - الوصول بالكثافة الطاقية إلى *$119.59 W"/"m^2$* عبر السماح بتلاقي الحواف العلوية والسفلية للصفوف المتتالية.
        - يضمن التصميم الإنشائي عدم إلقاء الصف الأمامي أي ظلال على الصف الذي يليه.
        - تحسين *التحميل الحراري الطبيعي (Natural Convection)* لتبريد الخلايا،.
      ],
      
      titled-block(title: "المحددات الفنية والتنفيذية للمصفوفة")[
        #set text(size: 13pt) // حجم خط مثالي لاحتواء التفاصيل بدقة داخل حدود الشريحة
        #set par(leading: 0.55em)
        
          1. ضبط زاوية السمت عند الصفر ($"Azimuth" = 0degree$) والمال المتساوي عند *31°* لضمان استمرارية الكتلة الميكانيكية حيال الزوايا الجانبية للشمس،.
          2. تأمين ممرات صيانة فنية بعرض *40 cm* واستبدال الحواف الإسمنتية بهياكل حديدية رقيقة لرفع كفاءة الاستغلال الفراغي.
      ]
    ),
    
    // العمود الثاني (يسار): المسقط البصري للتوزيع والمحاكاة على سطح البنك
    stack(
      dir: ttb,
      v(12pt), // إزاحة طفيفة لضمان التوسط الشاقولي المتميز مع النصوص الجانبية
      figure(
        block(
          stroke: 0.5pt + gray.lighten(60%),
          radius: 4pt,
          inset: 2pt,
          fill: white,
          image("Figures/PV-10-10.png", width: 100%) // تم استخدام 100% ليملأ العمود المخصص له بأعلى دقة ووضوح
        ),
        caption: [مخطط توجيه وتوزيع مصفوفات الألواح الشمسية على السطح باتجاه الجنوب تماماً وفق محاكاة التوزيع والتثبيت المتدرج]
      )
    )
  )
]



