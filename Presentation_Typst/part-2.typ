#slide[
  = اختيار المكون الأساسي (PV Module)
  #v(0.1cm)

  #grid(
    columns: (1.25fr, 1fr), // تقسيم مدروس يمنح النص مساحة مريحة ويترك مساحة كافية للجدول القادم
