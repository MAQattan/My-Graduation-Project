#slide[
  = تقييم كثافة الاستطاعة المساحية
  #v(0.1cm)

  #grid(
    columns: (1fr, 1fr), // تقسيم مساحي متناسق يمنح الحسابات الرقمية والمخطط النهائي توازناً بصرياً مريحاً
    gutter: 16pt,
    
    // العمود الأول (يمين): التحجيم الرقمي، القوانين الرياضية، وخلاصة الجدارة التصميمية
    stack(
      dir: ttb,
      spacing: 10pt,
      
      titled-block(title: "التحجيم الرقمي وحساب كثافة الاستطاعة")[
        #set text(size: 14pt)
        #set par(leading: 0.8em)
        
        - *القدرة المركبة المستهدفة ($P_("total")$):*
          $ P_("total") = 39 " Panels" times 600 " W" = 23,400 " W" = 23.4 " kWp" $
          
        - *إجمالي المساحة التصميمية ($text("Area")$):* بلغت المساحة الصافية المستغلة فعلياً فوق السطح المصرفي $195.67 " m"^2$.
        
        - *كثافة الاستطاعة المساحية:* تُحسب الجدارة المكانية للمنظومة وفق التعويض التالي:
          $ text("Power Density") = P_("total") / text("Area") = (23,400 " W") / (195.67 " m"^2) approx bold(119.59 " W/m"^2) $
      ],
      
      titled-block(title: "خلاصة الجدارة والتفوق التصميمي")[
        #set text(size: 12pt)
        #set par(leading: 0.7em)
        
        - نجاح منهجية "التصميم القائم على المساحة" في استعادة *40% - 50%* من رقعة السطح التي كانت ستُفقد حتماً عند اتباع أنماط التباعد التقليدية.
        
        - سمحت تقنية "التثبيت المتدرج" بدمج *5 ألواح إضافية* في المناطق الحرجة المجاورة للعوائق، مما رفع كثافة التوليد إلى حدها الأقصى دون نشوء أي تظليل متبادل.
      ]
    ),
    
    // العمود الثاني (يسار): المخطط الهندسي التنفيذي النهائي 2D لتوزيع الألواح
    stack(
      dir: ttb,
      v(12pt), // إزاحة ميكانيكية لتحقيق التوسط الشاقولي المثالي مع كتل النصوص
      figure(
        block(
          radius: 6pt,
          clip: true,
          stroke: 0.5pt + rgb("#e2e8f0"),
          fill: white, // خلفية بيضاء نقية لحماية خطوط وتفاصيل الألواح الـ 39 من التداخل
          [
            #image("Figures/PV-10-21.png", width: 100%) // تم تعديلها إلى 100% لتملأ إطار العمود المخصص لها بشكل متميز
          ]
        ),
        caption: [المخطط الهندسي النهائي ثنائي الأبعاد لمصفوفات الألواح الكهروضوئية وتوزيعها على المساحة السطحية الكلية للمبنى المصرفي]
      )
    )
  )
]



