#slide[
  = تحليل الظلال الهندسية

  #grid(
    columns: (1fr, 1.6fr), // توزيع مساحي يمنح المعادلات الرياضية مساحة مريحة للعرض
    gutter: 16pt,
    
    // العمود الأول (يمين): يضم الفلسفة التشغيلية والنمذجة الرياضية للظلال
    stack(
      dir: ttb,
      spacing: 8pt,
      
      titled-block(title: "النمذجة الرياضية للمسافات البينية")[
        #set text(size: 13pt)
        #set par(leading: 0.8em)
        
        - *الارتفاع الشاقولي الحرِج ($H$):* يُحسب بدلالة طول اللوح ($L$) وزاوية الميل ($beta$):
          $ H = L times sin(beta) $
          
        - *المسافة البينية النظرية ($D$):* تُشتق من زاوية ارتفاع الشمس ($theta$) عند الساعة 9:00 صباحاً:
          $ D = H / tan(theta) $
          
        - *معامل تصحيح السمت ($psi_("Correction")$):* الحل الابتكاري لتقليص المساحات المهدورة عبر حساب الفارق بين زاوية سمت الشمس وخط الجنوب الجغرافي.
        
        - *المسافة الدنيا المصححة ($D_("min")$):* القيمة النهائية المعتمدة تنفيديّاً:
          $ D_("min") = D times cos(psi_("Correction")) $
      ]
    ),
    // العمود الثاني (يسار): الرسم المتجهي الهندسي لحركة الشمس وسقوط الظل
    stack(
      dir: ttb,
      v(10pt), // محاذاة شاقولية متناسقة مع الصناديق الجانبية
      figure(  
        block(
          radius: 6pt,
          clip: true,
          stroke: 0.5pt + rgb("#e2e8f0"),
          fill: white,
          [
            #image("Figures/PV-10-17.png", width: 100%)
          ]
        ),
        caption: [رسم يوضح زاوية السمت وزاوية السمت المصححة هندسياً]
      )
    )
  )
]


#slide[
  = تحليل التظليل الموضعي والجانبي
  #v(0.1cm)

  #grid(
    columns: (2fr, 1fr), // تقسيم مساحي متوازن يتيح عرضاً مريحاً للنصوص والمخطط الهندسي
    gutter: 16pt,
    
    // العمود الأول (يمين): يغطي النقلة المنهجية والمعايير التقنية للتصميم والربط الكهربائي
    stack(
      dir: ttb,
      spacing: 8pt,
      
      titled-block(title: "تجاوز المنهجية التقليدية")[
        #set text(size: 13pt)
        #set par(leading: 0.52em)
        
        - *الانتقال النوعي:* تجاوز الممارسات الهندسية الشائعة التي تقتصر على حساب التظليل البيني الأفقي، نحو دراسة "حرم الظل" المعقد للعوائق الإنشائية الثابتة.
        - *تشخيص العوائق:* تحليل الأثر الجيومكاني لغرفة الدرج ووحدات التكييف المركزية نظراً لارتفاعها النسبي الذي يفرض تظليلاً عرضياً حرجاً في ساعات معينة.
      ],
            figure(
        block(
          radius: 6pt,
          clip: true,
          stroke: 0.5pt + rgb("#d8d8d8"),
          fill: white, // حلفية بيضاء نقية لحماية خطوط الأوتوكاد الدقيقة من التداخل
          [
            #image("Figures/PV-10-09.png", width: 100%) // تم تعديلها إلى 100% لتملأ إطار العمود المخصص لها بشكل متناسق
          ]
        ),
        caption: [تمثيل الظلال لوحدة التكييف وغرفة الدرج على المخطط المعماري للبنك في AutoCAD]
      )

      
    ),
    
    // العمود الثاني (يسار): مسقط الأوتوكاد المعماري ومحاكاة ظلال عوائق السطح للبنك
    stack(
      dir: ttb,
      v(15pt), // إزاحة عمودية مدروسة لتحقيق التوسط البصري المثالي مع الصناديق الجانبية
            titled-block(title: "المعايير التقنية للتصميم والربط الكهربائي")[
        #set text(size: 13pt)
        #set par(leading: 0.52em)
        
        - *النمذجة الرياضية ($D_("Lat")$):* حساب المسافة الجانبية للظل الجانبي (_Lateral Shading_) بدقة لضمان ابتعاد المصفوفة عن مسقط الظل القطري:
          $ D_("Lat") = D times sin(psi_("Correction")) $
          
        - *استراتيجية النافذة الزمنية:* تبني نافذة إشعاعية فعالة للعوائق (11:00 AM - 2:00 PM) في يوم التصميم لتجنب "العقوبة المساحية" المفرطة، مع قبول فواقد شتوية طفيفة جداً مقابل تعظيم الإنتاج الصيفي السنوي.
        
        - *العزل الكهربائي:* توظيف نتائج دراسة الظلال في "التوزيع الفعال" عبر عزل السلاسل (_Strings_) المتأثرة في مداخل مستقلة للعاكس لتجنب فواقد عدم الموائمة (_Mismatch Losses_).
      ]

    )
  )
]


#slide[
  = استغلال المساحات المظللة جزئياً
  #v(0.1cm)

  #grid(
    columns: (1fr, 1.5fr), // تقسيم مدروس يمنح المحاكاة ثلاثية الأبعاد والنصوص توازناً بصرياً ممتازاً
    gutter: 16pt,
    
    // العمود الأول (يمين): الفلسفة التصميمية والمعايير التقنية للاستمثال المساحي
    stack(
      dir: ttb,
      spacing: 10pt,
      
      titled-block(title: "الفلسفة التصميمية للاستمثال المساحي")[
        #set text(size: 13pt)
        #set par(leading: 0.7em)
        
        - تجاوز المنهجية التقليدية غير الاقتصادية التي تستبعد المساحات المظللة جزئياً، والتحول نحو "الاستغلال الهندسي المشروط" لتعظيم القدرة المركبة الإجمالية.
        
        - استغلال السلوك الهندسي المتغير للظل؛ حيث ينخفض ارتفاع مسقط الظل شاقولياً كلما ابتعدنا عن العائق الإنشائي المسبب له.
      ],
      
      titled-block(title: "المعايير التقنية والتحقق والمخرجات")[
        #set text(size: 13pt)
        #set par(leading: 0.7em)
        
        - *تحييد أثر التظليل الجزئي (البقعي):* ضمان مرور المسار الفراغي للظل بالكامل تحت مستوى الخلايا الفعالة للألواح، مما يلغي فواقد التظليل اللحظية تماماً ويحمى المصفوفة من ظاهرة البقع الساخنة (_Hotspots_).
        
        - *المخرجات الرقمية:* أتاحت هذه المناورة الهندسية دمج *5 ألواح إضافية* في المنظومة، مما ساهم في الوصول إلى كثافة الاستطاعة المستهدفة للبنك دون التضحية بالموثوقية التشغيلية.
      ]
    ),
    
    // العمود الثاني (يسار): المحاكاة ثلاثية الأبعاد لمساقط وتأثير الظلال الحرجة
    stack(
      dir: ttb,
      v(12pt), // إزاحة عمودية مدروسة لتحقيق التوسط الشاقولي المثالي مع الصناديق الجانبية
      align(horizon)[
      #figure(
        block(
          radius: 6pt,
          clip: true,
          stroke: 0.5pt + rgb("#d8d8d8"),
          fill: white,
          [
            #image("Figures/PV-10-12.png", width: 100%) // تم تعديل العرض إلى 100% ليملأ عموده المخصص ويبرز تفاصيل المحاكاة بوضوح
          ]
        ),
        caption: [محاكاة ثلاثية الأبعاد تظهر مساقط وتأثير الظلال الحرجة المتشكلة من غرفة الدرج ووحدة التكييف على الألواح المضافة]
      )]
    )
  )
]


#slide[
  = التحقق الرياضي للظلال
  #v(0.1cm)

  #grid(
