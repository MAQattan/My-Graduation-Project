  #v(0.1cm)

  #grid(
    columns: (1fr, 1.5fr), // تقسيم مدروس لاستيعاب كثافة التحليل الرياضي والمخططين الهندسيين معاً
    gutter: 14pt,
    
    // العمود الأول (يمين): يغطي منهجية إثبات الأمان، المعادلات الحسابية، وشروط الامتثال الهندسي
    stack(
      dir: ttb,
      spacing: 8pt, // مسافة أمان عمودية مدمجة لمنع تدفق الشريحة
      
      titled-block(title: "النمذجة الرياضية ونتائج الامتثال الهندسي")[
        #set text(size: 15pt) // حجم خط مثالي لضمان احتواء المعادلات والارقام بدقة
        #set par(leading: 0.8em)
        
        - *زاوية ميل الأشعة الشاقولية ($phi$):* تُحسب استناداً إلى أبعاد العائق والمسافة البينية الدنيا المعتمدة:
          $ phi = tan^(-1)(H_("Obstacle") / D_("min")) $
          
        - *ارتفاع الظل عند خط المقابلة:* يُحسب عند نقطة التلاقي الشاقولي مع الهيكل الحامل:
          $ text("Shadow Height") = l times tan(phi) $
          
        - *شرط الامتثال والتحقق الرقمي المعتمد:*
          - *وحدة التكييف:* ارتفاع الظل ($0.574 "m"$) < ارتفاع الهيكل ($1.173 "m"$) $arrow.l$ *آمن تماماً*.
          - *غرفة الدرج:* ارتفاع الظل ($0.763 "m"$) < ارتفاع الهيكل ($1.173 "m"$) $arrow.l$ *آمن تماماً*.
      ]
    ),
    
    // العمود الثاني (يسار): يستعرض المخطط الهندسي والمنظور ثلاثي الأبعاد للعوائق
    stack(
      dir: ttb,
      spacing: 10pt, // مسافة فاصلة مريحة بين الصورتين
      v(-30pt),
      
      figure(
        block(
          radius: 4pt,
          clip: true,
          stroke: 0.5pt + rgb("#e2e8f0"),
          fill: white,
          image("Figures/PV-10-16.png", width: 50%)
        ),
        caption: [منظور ثلاثي الأبعاد يوضح محاكاة زاوية سقوط الإشعاع الشمسي ومسار الظل المتشكل من وحدة التكييف على الهيكل المتدرج.]
      ),
      figure(
  image("Figures/PV-10-20.png", width: 60%),
  caption: [محاكاة فراغية ثلاثية الأبعاد تظهر سلوك ومسقط الظل الحرج لغرفة الدرج مقارنة بالهيكل الحامل للألواح]
)
    )
  )
