#import "@preview/polylux:0.4.0": *
#import "lib.typ" as friendly
#import friendly: titled-block

#slide[
  = أهمية المشروع وأهدافه
  #v(0.4cm)

  #grid(
    columns: (1fr, 1fr), // تقسيم الشريحة إلى عمودين متساويين
    gutter: 22pt,        // مسافة أمان أفقية أنيقة بين العمودين
    
    // العمود الأول: أهمية المشروع (يظهر يميناً تلقائياً)
    titled-block(title: "أهمية المشروع")[
      #set text(size: 14.5pt) // حجم خط مناسب جداً للمقروئية داخل الصناديق
      #set par(leading: 0.65em) // تباعد أسطر مريح بصرياً
      
      - *معالجة التناقض الفني:* حل الإشكالية التقنية بين متطلبات موثوقية التغذية العالية للمنشآت المصرفية وبين "المحدودية المكانية" والقيود الإنشائية للأسطح الحضرية.
      
      #v(0.5em)
      - *الابتكار الإنشائي:* تبني منهجية "التثبيت المتدرج" (_Terraced Mounting_) لرفع عامل استغلال المساحة (LUF) وتحييد فواقد التظليل المتبادل.
      
      #v(0.5em)
      - *الاستدامة الاقتصادية:* خفض تكلفة الوحدة الطاقية (LCOE) وتحقيق الاستقلال الطاقي المستدام والآمن للمنشأة المصرفية.
      
      #v(0.5em)
      - *مرجع تصميمي:* تقديم دليل هندسي تطبيقي ونموذجي لتصميم المنظومات المرتبطة بالشبكة في البيئات المعقدة والمقيدة مساحياً.
    ],

    // العمود الثاني: أهداف المشروع (يظهر يساراً تلقائياً)
    titled-block(title: "أهداف المشروع")[
      #set text(size: 14.5pt)
      #set par(leading: 0.65em)
      
      - *التصميم والاستمثال:* بناء وتصميم منظومة كهرضوئية مرتبطة بالشبكة بقدرة *23.4 kWp* لتغطية كامل الاحتياجات الطاقية الحرجة للبنك.
      
      #v(1em)
      - *تعظيم كثافة القدرة:* الوصول إلى كثافة استطاعة مساحية قياسية بلغت *119.59 W/m²* كفاءةً، رغم وجود عوائق إنشائية وظلال حرجة بالموقع.
      
      #v(1em)
      - *المواءمة الرقمية:* بناء "توأم رقمي" (_Digital Twin_) متكامل عبر برنامج *PVsyst* للتنبؤ الدقيق بمؤشرات الجدارة الطاقية (PR & Specific Yield) قبل البدء بالتنفيذ الفعلي.
    ]
  )
]

#slide[
  = مشكلة البحث (Research Problem)
  #v(0.1cm)
  
  // 1. التحدي الجوهري: إبراز المشكلة الأساسية بعرض كامل في الأعلى
  
  #v(0.2cm)
  
  // 2. تقسيم محتوى الشريحة إلى عمودين متزنين بصرياً
  #grid(
    columns: (1fr, 1.6fr), // إعطاء مساحة أكبر قليلاً للعمود النصي لراحة العين
    gutter: 5pt,          // المسافة البينية الفاصلة بين العمودين
        stack(
      dir: ttb,
      spacing: 8pt,
        block(
    width: 100%,
    inset: (x: 15pt, y: 12pt),
    radius: 5pt,
    fill: rgb("#383B64").lighten(95%),
    stroke: (right: 5pt + rgb("#383B64")), // خط جانبي أنيق بلون الثيم الكحلي
    [
      #text(weight: "bold", fill: rgb("#383B64"), size: 15pt)[التحدي الجوهري:]
      #h(2pt)
      #text(size: 14.5pt)[معالجة التناقض البنيوي بين المتطلبات العالية لموثوقية التغذية الكهربائية للمنشآت المصرفية الحيوية، وبين "المحدودية المكانية" والقيود الإنشائية المعقدة لسطح المنشأة.]
    ]
  ),

    // العمود الأول: الأبعاد التقنية للمشكلة
    titled-block(title: "الأبعاد التقنية للمشكلة")[
      #set text(size: 13.5pt)
      #set par(leading: 0.65em)            
      1. *القيد المساحي:* خسارة *40%-50%* من القدرة المركبة عند اتباع أنماط التباعد التقليدية لتجنب التظليل المتبادل.
      #v(0em)
      2. *العوائق المعمارية الحرجة:* تأثير "غرفة الدرج" و"وحدات التكييف" في نشوء فواقد *عدم التطابق (Mismatch)* وخطر *البقع الساخنة (Hotspots)*,.
      #v(0em)
      3. *فجوة اليقين الرقمي:* قصور الحسابات اليدوية الساكنة عن التنبؤ الدقيق بمؤشرات الجدارة الطاقية (*PR*) تحت وطأة الظلال المتغيرة.
    ]),
    [
    // العمود الثاني: التوضيح البصري والمخطط الهندسي
      #figure(
        block(
          radius: 6pt,
          clip: true,
          stroke: 0.5pt + rgb("#d8d8d8"),
          [
            #image("Figures/PV-10-11.png", width: 90%),
          ]
        ),
          caption: [تمثيل الظلال لوحدة التكييف وغرفة الدرج على المخطط المعماري للبنك في AutoCAD]
      )
    ]
  )
]



#slide[
  = منهجية العمل (Work Methodology)
  #v(0.1cm)
  #text(size: 14pt, weight: "medium", fill: rgb("#383B64").darken(10%))[
    تبنى البحث منهجية تحليلية وتطبيقية رصينة تتألف من خمس مراحل متسلسلة ومتكاملة هندسياً:
  ]
  #v(0.3cm)

  #grid(
    columns: (1fr, 1fr), // تقسيم الشريحة إلى عمودين متساويين
    gutter: 20pt,        // مسافة أمان أفقية مناسبة
    
    // العمود الأول: المراحل التمهيدية والهندسة المكانية (يظهر يميناً تلقائياً)
    titled-block(title: "أولاً: التوصيف المعرفي والهندسة المكانية")[
      #set text(size: 13.5pt)
      #set par(leading: 0.65em)
      
      *1. بناء الإطار المعرفي:* \
      توصيف تكنولوجيا الألواح المتقدمة المتطورة (_N-Type HPBC_) وتحليل طوبولوجيا العواكس متعددة المتعقبات (_Multi-MPPT_).
      
      #v(0.6em)
      *2. التقييم الجيومناخي:* \
      استخلاص المورد الإشعاعي الدقيق الخاص بموقع الدراسة وحساب ساعات الذروة الشمسية (_PSH_) لضمان دقة المدخلات.
      
      #v(0.6em)
      *3. الهندسة المكانية والظلال:* \
      اعتماد حل "التثبيت المتدرج" (_Terraced Mounting_) المبتكر وإجراء تحليل مثلثي صارم للظلال الموضعية والجانبية للأسطح.
    ],
    
    // العمود الثاني: التصميم الكهربائي والتحقق الرقمي (يظهر يساراً تلقائياً)
    titled-block(title: "ثانياً: المواءمة الكهربائية والتوأم الرقمي")[
      #set text(size: 13.5pt)
      #set par(leading: 0.65em)
      
      *4. المواءمة الكهربائية والحماية:* \
      دراسة حالات الجهد والتيار الحرجة تحت وطأة التغيرات الحرارية، وتصميم شبكة *الموصلات* ونظم تفريغ الأخطاء والحماية وفق مبدأ *"الانتقائية الصارمة"*.
      
      #v(1.4em)
      *5. بناء التوأم الرقمي (Digital Twin):* \
      النمذجة الديناميكية والمحاكاة الشاملة عبر برنامج *PVsyst* للتنبؤ بمؤشرات الجدارة الطاقية وعامل الإنتاجية السنوي للمنظومة (_PR & Specific Yield_).
    ]
  )
]





#slide[
  = التصنيف الفني للمنظومة (On-Grid System)
  #v(0.1cm)

  #grid(
    columns: (2.5fr, 1fr), // توزيع متوازن يمنح عمود الصورة والنص مساحة أكبر قليلاً
    gutter: 22pt,          // الفراغ الأفقي الفاصل بين العمودين
    
    // العمود الأول (يمين): الفلسفة التشغيلية وأسفلها مباشرة المخطط الهندسي
    stack(
      dir: ttb,
      spacing: 10pt, // مسافة أمان عمودية بين الصندوق والصورة
      
      titled-block(title: "الفلسفة التشغيلية ومسارات التغذية")[
        #set text(size: 12pt) // حجم خط متناسق لضمان عدم حدوث تراكب عمودي
        #set par(leading: 0.6em)
        
        - *التكامل مع الشبكة:* اعتماد الشبكة كبيئة تبادلية مرجعية (_Virtual Storage_) لاستقبال فائض القدرة نهاراً وتغطية العجز ليلاً، مما يلغي الحاجة للتخزين الكيميائي.
        
        #v(0.2em)
        - *الديناميكية اللحظية:* مواءمة مستمرة بين المورد الإشعاعي واستهلاك الأحمال الذاتية، مع حقن الفائض تلقائياً في الشبكة.
      ],
      
      // إدراج الصورة والتعليق أسفل الصندوق مباشرة
      figure(
        block(
          stroke: 0.5pt + gray.lighten(60%),
          radius: 4pt,
          inset: 2pt,
          fill: white,
          image("Figures/PV-10-03.jpg", width: 80%)
        ),
        caption: [مخطط تدفق هندسي يوضح المكونات التشغيلية لمنظومة كهرضوئية متصلة بالشبكة بالتوازي مع أحمال المبنى وتحديد نقاط الفصل الكهربائي]
      )
    ),
    
    // العمود الثاني (يسار): المكونات البنيوية الأساسية للمنظومة
    titled-block(title: "المكونات البنيوية الأساسية للمنظومة")[
      #set text(size: 12.5pt)
      #set par(leading: 0.65em)
      
      - *المصفوفة الكهروضوئية (_PV Array_):* المصدر الأساسي لتوليد التيار المستمر (DC) من الطاقة الشمسية.
      
      #v(0.5em)
      - *العاكس المتفاعل (_Grid-interactive Inverter_):* المسؤول عن تحويل القدرة ومزامنة الجهد والتردد وزاوية الطور مع الشبكة، والمدمج به خوارزميات _MPPT_.
      
      #v(0.5em)
      - *نظام القياس التبادلي (_Net Metering_):* عداد ذكي لمعايرة تدفق الطاقة ثنائي الاتجاه واحتساب المحصلة الطاقية للبنك.
      
      #v(0.5em)
      - *بروتوكول الأمان :* ميزة "منع التجزير" لضمان الفصل الفوري للمنظومة عند انقطاع تيار الشبكة العامة لحماية أطقم الصيانة.
    ]
  )
]